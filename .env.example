# Copy this to .env and fill in real values (never commit .env itself)

# Development example. Never commit the populated .env file.
DEBUG=true
SECRET_KEY=change-this-to-something-random
ALLOWED_HOSTS=localhost,127.0.0.1
SECURE_SSL_REDIRECT=false
SECURE_HSTS_PRELOAD=false
DB_ENGINE=django.db.backends.mysql
DB_NAME=docatdoor
DB_USER=docatdoor
DB_PASSWORD=replace-with-a-local-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60
MYSQL_ROOT_PASSWORD=replace-with-a-local-mysql-root-password

# Email notifications are suppressed when MAIL_ENABLED=false. Configure SMTP
# and set MAIL_ENABLED=true to deliver verification and reset messages.
MAIL_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# Optional support inbox used for website service enquiries.
# Replace with an inbox you control before enabling real SMTP delivery.
SUPPORT_EMAIL=

# Service enquiries are eligible for deletion after this many days.
# Run `python manage.py purge_service_enquiries` to review; add --execute to delete.
SERVICE_ENQUIRY_RETENTION_DAYS=180

# Doctor verification is done through Django's own admin site (/django-admin/).
# Create that login with: python manage.py createsuperuser

# How many minutes before a confirmed appointment to send a reminder email
REMINDER_LEAD_MINUTES=60
